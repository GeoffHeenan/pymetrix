{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeoffHeenan/pymetrix/packages/pymetrix-eviews/bundle-1.schema.json",
  "title": "pymetrix EViews bundle manifest, format version 1",
  "description": "The manifest (.evbundle) that pymetrix_export.prg writes. Within version 1 changes are additive: readers keep and note keys they do not know, so objects allow other properties.",
  "type": "object",
  "required": ["format", "format_version", "exporter", "workfile", "pages"],
  "properties": {
    "format": {"const": "pymetrix-eviews-bundle"},
    "format_version": {"const": 1},
    "exporter": {
      "type": "object",
      "required": ["program_version"],
      "properties": {
        "program_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
        "eviews_version": {"type": "string"},
        "exported": {"type": "string"}
      }
    },
    "workfile": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "active_page": {"type": "string"}
      }
    },
    "na": {"type": "string", "minLength": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "file": {"type": "string", "minLength": 1, "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"},
    "page": {
      "type": "object",
      "required": ["name", "structure", "file", "series"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "structure": {"enum": ["dated", "undated", "panel"]},
        "frequency": {"type": "string"},
        "range": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "sample": {"type": "string"},
        "file": {"$ref": "#/$defs/file"},
        "date_column": {"type": ["string", "null"]},
        "id_columns": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
        "groups": {"type": "array", "items": {
          "type": "object", "required": ["name", "members"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "members": {"type": "array", "items": {"type": "string"}}}}},
        "samples": {"type": "array", "items": {
          "type": "object", "required": ["name", "text"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "text": {"type": "string"}}}},
        "scalars": {"type": "array", "items": {
          "type": "object", "required": ["name", "value"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "value": {"type": ["number", "null"]}}}},
        "strings": {"type": "array", "items": {
          "type": "object", "required": ["name", "value"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "value": {"type": "string"}}}},
        "arrays": {"type": "array", "items": {
          "type": "object", "required": ["name", "type", "rows", "cols", "file"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"enum": ["vector", "rowvector", "matrix", "sym", "coef"]},
                         "rows": {"type": "integer", "minimum": 0}, "cols": {"type": "integer", "minimum": 0},
                         "file": {"$ref": "#/$defs/file"}}}},
        "value_maps": {"type": "array", "items": {
          "type": "object", "required": ["name", "file"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "file": {"$ref": "#/$defs/file"}}}},
        "equations": {"type": "array", "items": {
          "type": "object", "required": ["name", "method"],
          "oneOf": [{"required": ["command"]}, {"required": ["command_file"]}],
          "properties": {"name": {"$ref": "#/$defs/name"}, "command": {"type": "string"}, "command_file": {"$ref": "#/$defs/file"},
                         "method": {"type": "string"}, "sample": {"type": "string"},
                         "ncoef": {"type": "integer", "minimum": 0}, "estimates": {"$ref": "#/$defs/file"}}}},
        "models": {"type": "array", "items": {
          "type": "object", "required": ["name", "text"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "text": {"$ref": "#/$defs/file"}}}},
        "skipped": {"type": "array", "items": {
          "type": "object", "required": ["name", "type"],
          "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "reason": {"type": "string"}}}}
      },
      "allOf": [
        {"if": {"properties": {"structure": {"enum": ["dated", "panel"]}}},
         "then": {"required": ["frequency", "date_column"], "properties": {"date_column": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"structure": {"const": "panel"}}},
         "then": {"required": ["id_columns"], "properties": {"id_columns": {"minItems": 1}}}}
      ]
    },
    "series": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "kind": {"enum": ["numeric", "alpha"]},
        "display_name": {"type": "string"},
        "description": {"type": "string"},
        "units": {"type": "string"},
        "source": {"type": "string"},
        "remarks": {"type": "string"},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
        "value_map": {"type": ["string", "null"]}
      }
    }
  }
}
